# Copy to .env and fill in. Defaults run a safe demo with no external calls.

BUSINESS_NAME="Lone Star Air & Plumbing"
BUSINESS_TIMEZONE=America/Chicago
OPEN_HOUR=7
CLOSE_HOUR=19
OWNER_PHONE=

ESCALATION_MINUTES=5
DEDUPE_WINDOW_HOURS=24
DATABASE_PATH=data/leads.db

# console (demo, prints nothing outbound) | twilio
NOTIFIER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VERIFY_TWILIO_SIGNATURE=false
PUBLIC_BASE_URL=http://localhost:8000

# none | hubspot
CRM=none
HUBSPOT_TOKEN=

# Required when DEMO_MODE=false
WEBHOOK_SECRET=
DEMO_MODE=true
MAX_SEND_ATTEMPTS=3
